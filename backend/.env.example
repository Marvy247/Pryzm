# Pryzm — Backend Environment Variables

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Somnia Testnet / DreamDEX ────────────────────────────────────────────────
# Get STT test tokens from: https://t.me/+XHq0F0JXMyhmMzM0
SOMNIA_PRIVATE_KEY=0x_your_wallet_private_key_here
SOMNIA_WALLET_ADDRESS=0x_your_wallet_address_here
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_RPC_URL=wss://dream-rpc.somnia.network/ws
SOMNIA_INDEXER_URL=https://indexer.dreamdex.io
SOMNIA_VENUE_ID=1

# ─── AI / LLMs ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Grok for sentiment agent (web search capability)
# If not set, sentiment agent falls back to GPT-4o
SCANNER_API_KEY=your_grok_api_key_here
SCANNER_BASE_URL=https://api.x.ai/v1
SCANNER_MODEL=grok-2-latest

# ─── Data Sources ─────────────────────────────────────────────────────────────
# Tavily — news and sentiment search (required for sentiment agent)
TAVILY_API_KEY=tvly-your_tavily_key_here

# Binance — OHLCV data (no key needed, public API)
# No config required

# ─── Database ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_KEY=eyJ_your_supabase_service_key_here

# ─── Agent Settings ───────────────────────────────────────────────────────────
# Minimum edge % to place a trade (default: 10 = 10%)
EC_MIN_EDGE_PERCENT=10

# Maximum single position size in USD
EC_MAX_POSITION_SIZE_USD=20

# Hard stop: halt trading if total P&L drops below this % of max position
EC_MAX_DRAWDOWN_PERCENT=30

# Minimum seconds remaining on market window before skipping
EC_MIN_EXPIRY_HEADROOM_SECONDS=300

# How often the agent cycle runs (minutes)
EC_RUN_INTERVAL_MINUTES=5
